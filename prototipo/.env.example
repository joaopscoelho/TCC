# ATENCAO: o prototipo ainda NAO carrega este arquivo sozinho. As variaveis
# abaixo precisam existir no ambiente do sistema (export no macOS/Linux,
# $env: no PowerShell) ou ser passadas por --modelo e --host na CLI.

# Fase 2 local (Ollama) - opcionais; os valores abaixo ja sao o padrao.
# OLLAMA_HOST=127.0.0.1:11434
# ANALISADOR_MODELO=qwen3:8b

# Nuvem do Ollama (ollama.com) - opcional. Chave em ollama.com/settings/keys.
# Use com: --host https://ollama.com --modelo gemma4:31b
# O codigo analisado sai da maquina neste modo.
# OLLAMA_API_KEY=

# Fase 2 nuvem - ADIADA. Chave gerada em console.anthropic.com (conta de
# API, separada do plano Pro). Nunca comite o .env de verdade.
ANTHROPIC_API_KEY=
